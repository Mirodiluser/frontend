// Runs the REAL transliterator from the site (app/lib/uzTranslit.ts) so every string in the film
// is exactly what TAHRIR AI produces. Output: src/data.gen.js
import * as U from '../../app/lib/uzTranslit.ts';
import {writeFileSync} from 'node:fs';
const L2C=(s:string)=>U.latinToCyrillic(s), C2L=(s:string)=>U.cyrillicToLatin(s);
const docLatin = {
  title:'Oʻzbek tilining raqamli kelajagi',
  sub:'Ilmiy-ommabop maqola',
  p1:['Bugungi kunda oʻzbek tilida yaratilayotgan matnlar soni','tobora ortib bormoqda. Davlat idoralari, oliy taʼlim','muassasalari va nashriyotlar hujjatlarni lotin yozuvida','tayyorlashga oʻtmoqda.'],
  lead:'Asosiy vazifa —',
  p2:['matnning mazmuni va tuzilishini saqlagan holda yozuvni','toʻgʻri almashtirishdir.'],
  lh:'Maqolada quyidagi masalalar koʻrib chiqiladi:',
  li:['kirill va lotin yozuvlari oʻrtasidagi farqlar;','ilmiy matnlarda atamalarning toʻgʻri yozilishi;','hujjat formatini saqlash usullari.'],
  cap:'1-jadval. Namuna maʼlumotlar',
  th:['Koʻrsatkich','2023-yil','2024-yil'],
  tr:[['Nashr etilgan kitoblar','1 240','1 515'],['Ilmiy maqolalar','860','1 020'],['Elektron hujjatlar','3 400','4 750']],
  p3:['Toʻgʻri tanlangan vositalar muallifga vaqtni tejash va','matn sifatini oshirishga yordam beradi.'],
};
const map=(o:any,f:(s:string)=>string):any=>typeof o==='string'?f(o):Array.isArray(o)?o.map(x=>map(x,f)):Object.fromEntries(Object.entries(o).map(([k,v])=>[k,map(v,f)]));
const docCyr=map(docLatin,L2C);
const docLat=map(docCyr,C2L); // what the tool returns for the Cyrillic upload
const bad:string[]=[];
const walk=(a:any,b:any,p='')=>{if(typeof a==='string'){if(a!==b)bad.push(p+': '+JSON.stringify(a)+' != '+JSON.stringify(b));}else for(const k in a)walk(a[k],b[k],p+'.'+k)};
walk(docLatin,docLat);
const trA=L2C('Oʻzbek tili — xalqimizning maʼnaviy boyligi.');
const trAOut=C2L(trA);
const trB='Ritsar haqidagi kitob kutubxonaga keldi.';
const anB=U.analyzeLatin(trB);
const trBAi=U.latinToCyrillic(trB,{[U.wordKey('Ritsar')]:'рицарь'});
const pre=(s:string,f:(x:string)=>string)=>Array.from({length:s.length+1},(_,i)=>f(s.slice(0,i)));
const trAPrefix=pre(trA,C2L), trBPrefix=pre(trB,L2C);
const wordsA=Array.from({length:trA.length+1},(_,i)=>U.countWords(trA.slice(0,i))), wordsB=Array.from({length:trB.length+1},(_,i)=>U.countWords(trB.slice(0,i)));
const trABack=L2C(trAOut);
const out={trAPrefix,trBPrefix,wordsA,wordsB,trABack,docCyr,docLat,trA,trAOut,trAChars:trA.length,trAWords:U.countWords(trA),trB,trBOut:anB.result,trBUncertain:anB.uncertain,trBAi,trBChars:trB.length,trBWords:U.countWords(trB),roundTripIssues:bad};
writeFileSync(new URL('../src/data.gen.js',import.meta.url),'// AUTO-GENERATED by scripts/precompute.mts from app/lib/uzTranslit.ts — do not edit\nwindow.GEN='+JSON.stringify(out,null,1)+';\n');
console.log(JSON.stringify(out,null,1));
